				{
					"name": "show_person",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {\r",
									"    pm.response.to.have.status(200);\r",
									"});\r",
									"\r",
									"pm.test(\"Default fields are valued\", function (){\r",
									"    let expected_person = pm.variables.get('person');\r",
									"\r",
									"    let person = pm.response.json().data;\r",
									"    pm.expect(parseInt(person.id)).to.eql(pm.variables.get('person_id'));\r",
									"    pm.expect(person.type).to.eql('sample_person');\r",
									"    pm.expect(person.attributes.last_name).to.eql(expected_person.attributes.last_name);\r",
									"    pm.expect(person.attributes.first_name).to.eql(expected_person.attributes.first_name);\r",
									"    pm.expect(person.attributes.is_director).to.eql(expected_person.attributes.is_director);\r",
									"});\r",
									"\r",
									"pm.test(\"Links are present\", function () {\r",
									"    let person = pm.response.json().data;\r",
									"\r",
									"    let person_id = pm.variables.get('person_id');\r",
									"\r",
									"    pm.expect(person.links.self).to.contain('/api/sample/persons/' + person_id);\r",
									"    pm.expect(person.links.schema).to.contain('/api/schemas/sample_person');\r",
									"    pm.expect(person.links.history).to.contain('/api/history/sample_person/' + person_id);\r",
									"});"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"pm.sendRequest(\r",
									"    {\r",
									"        \"url\": pm.environment.get('Host') + \"/api/fixtures/sample_director?relations=objectFixtures\",\r",
									"        \"header\": {\"Authorization\": pm.variables.get(\"auth\")}\r",
									"    },\r",
									"    function (err, response) {\r",
									"        const json = response.json();\r",
									"        const id = json.data[0].attributes.object_id;\r",
									"        let person = null;\r",
									"\r",
									"        json.included.each(function (elem) {\r",
									"            if (elem.type == 'sample_person' && elem.id == id) {\r",
									"                person = elem;\r",
									"            }\r",
									"        });\r",
									"\r",
									"        pm.variables.set(\"person\", person);\r",
									"        pm.variables.set(\"person_id\", id);\r",
									"    }\r",
									");"
								],
								"type": "text/javascript"
							}
						}
