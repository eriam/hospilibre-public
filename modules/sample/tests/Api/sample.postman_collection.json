		{
			"name": "Persons",
			"item": [
				{
					"name": "list_persons",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {\r",
									"    pm.response.to.have.status(200);\r",
									"});\r",
									"\r",
									"pm.test(\"Count and total are in meta\", function (){\r",
									"    let json_body = pm.response.json();\r",
									"    count = json_body.meta.count;\r",
									"    pm.expect(json_body.meta.count).to.eql(5);\r",
									"    pm.expect(json_body.meta.total).to.greaterThan(count);\r",
									"});\r",
									"\r",
									"pm.test(\"Each person have a profile picture\", function () {\r",
									"    let json_body = pm.response.json();\r",
									"    json_body.data.each(function (element) {\r",
									"        pm.expect(element.type).to.eql('sample_person');\r",
									"        pm.expect(element.links.profile_picture).to.contains('?m=files&raw=thumbnail&document_id=');\r",
									"    });\r",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{Host}}/api/sample/persons?limit=5",
							"host": [
								"{{Host}}"
							],
							"path": [
								"api",
								"sample",
								"persons"
							],
							"query": [
								{
									"key": "limit",
									"value": "5"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "list_persons_with_relations",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {\r",
									"    pm.response.to.have.status(200);\r",
									"});\r",
									"\r",
									"pm.test(\"Each relationship have the right name and the right type\", function () {\r",
									"    let json_body = pm.response.json();\r",
									"    json_body.data.each(function (element) {\r",
									"        pm.expect(element.type).to.eql('sample_person');\r",
									"\r",
									"        // Check for each relation the name of if and the data type.\r",
									"        if (element.relationships.nationality) {\r",
									"            pm.expect(element.relationships.nationality.data.type).to.eql('sample_nationality');\r",
									"        }\r",
									"        \r",
									"        if (element.relationships.profilePicture) {\r",
									"            pm.expect(element.relationships.profilePicture.data.type).to.eql('file');\r",
									"        }\r",
									"\r",
									"        if (element.relationships.moviesPlayed) {\r",
									"            element.relationships.moviesPlayed.data.each(function (movie_played) {\r",
									"                pm.expect(movie_played.type).to.eql('sample_movie');\r",
									"            });\r",
									"        }\r",
									"    });\r",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{Host}}/api/sample/persons?limit=5&relations=all",
							"host": [
