									"                                            director_id: pm.variables.get('person_id')\r",
									"                                        }\r",
									"                                    }\r",
									"                                }\r",
									"                            )\r",
									"                        }\r",
									"                    },\r",
									"                    function (err, response) {\r",
									"                        pm.variables.set(\"movie_id\", response.json().data[0].id);\r",
									"                    }\r",
									"                );\r",
									"            }\r",
									"        );\r",
									"    }\r",
									");"
